---
import flareLogo from '../assets/flare-logo.png';
const { siteTitleHref } = Astro.locals.starlightRoute;
const VERSION = '0.1.x';
---

<a href={siteTitleHref} class="site-title sl-flex">
  <img src={flareLogo.src} alt="Flare" class="flare-mark" />
  <span class="sr-only">Flare</span>
  <span class="flare-version" aria-label={`Version ${VERSION}`}>{VERSION}</span>
</a>

<style>
  @layer starlight.core {
    .site-title {
      align-items: flex-end;
      gap: 0.625rem;
      text-decoration: none;
      white-space: nowrap;
      min-width: 0;
      color: var(--sl-color-white);
    }
  }
  .flare-mark {
    height: 2.5rem;
    width: auto;
    display: block;
  }
  .flare-version {
    display: inline-flex;
    align-items: center;
    height: 1.375rem;
    padding: 0 0.5rem;
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--flare-mint, #2ae5a0);
    background: rgba(42, 229, 160, 0.12);
    border: 1px solid rgba(42, 229, 160, 0.35);
    border-radius: 999px;
  }
</style>
