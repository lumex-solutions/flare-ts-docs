---
const { siteTitleHref } = Astro.locals.starlightRoute;
const VERSION = '0.1.x';
---

<a href={siteTitleHref} class="site-title sl-flex">
  <svg
    class="flare-mark"
    viewBox="0 0 184 48"
    role="img"
    aria-label="Flare"
    width="120"
    height="32"
  >
    <g fill="#2ae5a0" transform="translate(4 0)">
      <rect x="12" y="0" width="6" height="6"/>
      <rect x="12" y="6" width="6" height="6"/><rect x="18" y="6" width="6" height="6"/>
      <rect x="6" y="12" width="6" height="6"/><rect x="12" y="12" width="6" height="6"/><rect x="18" y="12" width="6" height="6"/><rect x="24" y="12" width="6" height="6"/>
      <rect x="6" y="18" width="6" height="6"/><rect x="12" y="18" width="6" height="6"/><rect x="18" y="18" width="6" height="6"/><rect x="24" y="18" width="6" height="6"/>
      <rect x="0" y="24" width="6" height="6"/><rect x="6" y="24" width="6" height="6"/><rect x="12" y="24" width="6" height="6"/><rect x="18" y="24" width="6" height="6"/><rect x="24" y="24" width="6" height="6"/><rect x="30" y="24" width="6" height="6"/>
      <rect x="0" y="30" width="6" height="6"/><rect x="6" y="30" width="6" height="6"/><rect x="12" y="30" width="6" height="6"/><rect x="18" y="30" width="6" height="6"/><rect x="24" y="30" width="6" height="6"/><rect x="30" y="30" width="6" height="6"/>
      <rect x="0" y="36" width="6" height="6"/><rect x="6" y="36" width="6" height="6"/><rect x="12" y="36" width="6" height="6"/><rect x="18" y="36" width="6" height="6"/><rect x="24" y="36" width="6" height="6"/><rect x="30" y="36" width="6" height="6"/>
      <rect x="6" y="42" width="6" height="6"/><rect x="12" y="42" width="6" height="6"/><rect x="18" y="42" width="6" height="6"/><rect x="24" y="42" width="6" height="6"/>
    </g>
    <text
      x="50"
      y="38"
      font-family="'Inter Tight', system-ui, -apple-system, sans-serif"
      font-weight="900"
      font-size="40"
      letter-spacing="-1.5"
      fill="currentColor"
    >flare</text>
  </svg>
  <span class="sr-only">Flare</span>
  <span class="flare-version" aria-label={`Version ${VERSION}`}>{VERSION}</span>
</a>

<style>
  @layer starlight.core {
    .site-title {
      align-items: center;
      gap: 0.625rem;
      text-decoration: none;
      white-space: nowrap;
      min-width: 0;
      color: var(--sl-color-white);
    }
  }
  .flare-mark {
    height: 2.5rem;
    width: auto;
    display: block;
  }
  .flare-version {
    display: inline-flex;
    align-items: center;
    height: 1.375rem;
    padding: 0 0.5rem;
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--flare-mint, #2ae5a0);
    background: rgba(42, 229, 160, 0.12);
    border: 1px solid rgba(42, 229, 160, 0.35);
    border-radius: 999px;
  }
</style>
