---
import MobileTableOfContents from 'virtual:starlight/components/MobileTableOfContents';
import TableOfContents from 'virtual:starlight/components/TableOfContents';

const { entry, toc } = Astro.locals.starlightRoute;
const EDIT_BASE = 'https://github.com/lumex-solutions/flare-ts-docs/edit/main/src/content/docs/';

// `entry.id` is the slug-relative path within the docs collection (e.g.
// `core/http/routing.md`). Append it to the edit base for a one-click PR.
const editHref = EDIT_BASE + entry.id;
---

<div class="lg:sl-hidden">
  <MobileTableOfContents />
</div>

<div class="right-sidebar-panel sl-hidden lg:sl-block">
  <div class="sl-container">
    {toc && <TableOfContents />}

    <section class="flare-page-actions not-content">
      <a href={editHref} class="flare-page-action" target="_blank" rel="noreferrer noopener">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M16.474 5.408 18.59 7.524M3 21h4l11-11-4-4L3 17v4Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Edit this page
      </a>
      <a
        href="https://github.com/lumex-solutions/flare-ts-docs/issues/new"
        class="flare-page-action"
        target="_blank"
        rel="noreferrer noopener"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Report an issue
      </a>
    </section>

    <aside class="flare-help-card not-content" aria-label="Need help">
      <div class="flare-help-label">Need help?</div>
      <p class="flare-help-body">Ask in Discord for real-time answers, or open a discussion for longer threads.</p>
      <a class="flare-help-link" href="https://discord.gg/BpfrzKhhsV">
        Discord
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a class="flare-help-link" href="https://github.com/lumex-solutions/flare-ts/discussions">
        GitHub Discussions
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </aside>
  </div>
</div>

<style>
  @layer starlight.core {
    .right-sidebar-panel {
      padding: 1rem var(--sl-sidebar-pad-x);
    }
    .sl-container {
      width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
    }
    .right-sidebar-panel :global(h2) {
      color: var(--sl-color-white);
      font-size: var(--sl-text-h5);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
      margin-bottom: 0.5rem;
    }
    .right-sidebar-panel :global(:where(a)) {
      display: block;
      font-size: var(--sl-text-xs);
      text-decoration: none;
      color: var(--sl-color-gray-3);
      overflow-wrap: anywhere;
    }
    .right-sidebar-panel :global(:where(a):hover) {
      color: var(--sl-color-white);
    }
    @media (min-width: 72rem) {
      .sl-container {
        max-width: calc(
          (
            (
                100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 *
                  var(--sl-sidebar-pad-x)
              ) * 0.25
          )
        );
      }
    }
  }

  .flare-page-actions {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    display: grid;
    gap: 0.35rem;
  }

  .flare-page-action {
    display: inline-flex !important;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem !important;
    color: var(--sl-color-gray-3) !important;
    transition: color 0.12s ease;
  }

  .flare-page-action:hover {
    color: var(--sl-color-white) !important;
  }

  .flare-page-action svg {
    flex: 0 0 auto;
    opacity: 0.7;
  }

  .flare-help-card {
    margin-top: 1.25rem;
    padding: 0.875rem 1rem 1rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: var(--flare-radius);
    background: linear-gradient(
      180deg,
      rgba(42, 229, 160, 0.06),
      rgba(42, 229, 160, 0.02)
    );
    position: relative;
    overflow: hidden;
  }

  .flare-help-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--flare-mint);
  }

  .flare-help-label {
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--flare-mint);
  }

  .flare-help-body {
    margin: 0.4rem 0 0.6rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  .flare-help-link {
    display: inline-flex !important;
    align-items: center;
    gap: 0.3rem;
    width: fit-content;
    font-size: 0.8rem !important;
    font-weight: 600 !important;
    color: var(--flare-mint) !important;
    margin-top: 0.3rem;
  }

  .flare-help-link:hover {
    color: var(--flare-mint-bright) !important;
  }

  .flare-help-link svg {
    transition: transform 0.12s ease;
  }

  .flare-help-link:hover svg {
    transform: translateX(2px);
  }
</style>
